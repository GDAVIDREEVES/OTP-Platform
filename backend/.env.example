# Path to the directory containing the parquet sub-folders:
#   entity_roles/  segment_pl/  supply_chain_flows/  journal_entries/
# Leave unset to use the committed sample at data/parquet/ (a fresh clone
# boots out of the box). Set it to a full ACDOCA export for full-fidelity demos:
# DATA_DIR=/Users/gregreeves/Documents/acdoca_exports/20260429-115302 NEW 29april26

# Where mutable app state lives (audit, drafts, users, review, adjustments).
# Defaults to backend/state/otp_state.db.
# OTP_STATE_DB=backend/state/otp_state.db

# ── Research Brain (the in-app TP assistant) ──────────────────────────────
# Answer paths, best available first:
#   1. researchbrain retrieval + Claude synthesis  (both blocks below set)
#   2. Claude direct, no citations                 (only ANTHROPIC_API_KEY set)
#   3. shaped offline text                         (nothing set)
# GET /api/research-brain/status reports which path is active.
#
# Claude API key — enables synthesis and the direct-answer path.
# ANTHROPIC_API_KEY=sk-ant-...
# OTP_CLAUDE_MODEL=claude-opus-5-5
#
# researchbrain HTTP service (TP knowledge retrieval). If it runs on another
# machine (e.g. the Mac mini) point at it over the LAN / Tailscale and start
# researchbrain with BIND_HOST=0.0.0.0.
# RESEARCH_BRAIN_BASE_URL=http://127.0.0.1:3000
# Its bearer token — the same value as RESEARCHBRAIN_API_KEY in researchbrain's .env.
# RESEARCH_BRAIN_API_KEY=your-secret-bearer-token

# CORS allow-list (comma-separated). Vite default is 5173.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  (not needed in single-port mode)

# Bind address & port for uvicorn
HOST=127.0.0.1
PORT=8000
